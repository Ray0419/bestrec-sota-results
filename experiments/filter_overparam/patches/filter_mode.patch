+        # filter_mode ladder (all nested inside `full`, the published design):
+        #   full   : per-frequency x per-channel   (L/2+1) * d * 2
+        #   rank1  : separable freq (x) channel    (L/2+1)*2 + d*2
+        #   shared : per-frequency, channel-tied   (L/2+1) * 2
+        #   none   : filter removed (identity anchor)
+        self.filter_mode = getattr(args, "filter_mode", "full")
+        n_freq = args.max_seq_length // 2 + 1
+        if self.filter_mode == "full":
+            self.complex_weight = nn.Parameter(
+                torch.randn(1, n_freq, args.hidden_size, 2, dtype=torch.float32) * 0.02)
+        elif self.filter_mode == "shared":
