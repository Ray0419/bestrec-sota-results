external/AmazonReviews2023/

# model checkpoints (E-F/E-G fusion bases): local artifacts. NOTE (audit
# 2026-07-23 15:59): results JSONs record init_state_sha256 (initial state),
# and runs after 2026-07-23 also record best_ckpt_sha256 (final checkpoint);
# earlier E-F/E-G checkpoints have no recorded final digest -- their
# regeneration boundary is the seed-deterministic training command.
_bestrec_run/*.best.pt

# deterministic control caches (E-B): regenerated by cloud/make_control_caches.py; hashes gate provenance
cache_5core/controls/

# verified EASE cache: regenerable, keyed+digest-checked by fuse_ease_eval.ease_B
_bestrec_run/ease_cache/
cloud/returns/

# audit 2026-07-23 22:00 ROOT-CAUSE FIX: sequestered-campaign endpoint
# artifacts must NEVER be committed before one-time adjudication (a git add -A
# on an unrelated commit exposed 14 partial E-G2 confirm JSON/NPZ mid-run).
# These are regenerable from the seed-deterministic commands; only the FINAL
# adjudication JSON is committed, after the full family is sealed.
_bestrec_run/results_*COLDFUSE2*
_bestrec_run/results_*COLDFUSE3*
_bestrec_run/results_*TEXTPERM*
_bestrec_run/results_*.finaleval.json
_bestrec_run/results_*.finaleval.perusers.npz
