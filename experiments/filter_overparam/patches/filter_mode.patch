+                torch.randn(1, n_freq, 1, 2, dtype=torch.float32) * 0.02)
+            # channel gain initialised at unit modulus so the product matches
+            # the `shared` scale at step 0
+            gain = torch.zeros(1, 1, args.hidden_size, 2, dtype=torch.float32)
+            gain[..., 0] = 1.0
+            self.channel_gain = nn.Parameter(gain)
+        elif self.filter_mode == "none":
+            pass
+        else:
+            raise ValueError(f"unknown filter_mode {self.filter_mode}")
