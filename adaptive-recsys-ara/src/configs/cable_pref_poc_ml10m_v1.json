      "full_semantic_score_path",
      "semantic_complement_mask_and_stable_topk",
      "fusion",
      "final_sort"
    ],
    "excluded_operations": ["training", "metadata_encoding", "index_construction", "disk_io", "target_or_metric_join"],
    "record_hardware": ["cpu_model", "logical_core_count", "process_affinity", "python_faiss_blas_versions", "visible_power_policy_metadata"],
    "machine_selection_rule": "current_preoutcome_machine_only_no_postoutcome_substitution"
  },
  "promise_gate": {
    "G1": {
      "name": "exact_feasibility_and_action_consistency",
      "collaborative_candidates_exact": 200,
      "semantic_candidates_exact": 200,
      "hybrid_union_exact": 400,
      "union_scope": "hybrid_methods_only_BPR_serves_shared_200_branch",
      "require_unique_unseen_and_semantic_BPR_novel": true,
      "require_independent_full_score_stable_sort_ID_and_order_replay": true,
      "require_synthetic_and_real_leave_out_admission_equivalence": true,
      "require_deterministic_score_item_ID_ties": true,
      "require_immutable_item_matrices_and_indexes": true
    },
    "G2": {
      "name": "material_preferred_admission",
      "conditional_admission_minimum_point_gain": {
        "raw_hybrid": 0.02,
        "order_only": 0.01
      },
      "require_paired_95_percent_lower_bound_above_zero_each": true,
      "net_new_preferred_support_minimum_point_gain_over_raw": 0.01,
      "require_net_new_preferred_support_lower_bound_above_zero": true,
      "require_point_net_admission_advantage_above_raw": true
    },
    "G3": {
      "name": "served_preference_utility",
      "spce_at_10_minimum_point_gain_each": 0.005,
      "comparators": ["raw_hybrid", "bpr"],
      "require_paired_95_percent_lower_bound_above_zero_each": true,
      "require_positive_point_preferred_endpoint_top_10_exposure_gain_over_raw": true
    },
    "G4": {
      "name": "relevance_and_dislike_safety",
      "relevance_comparator": "validation_selected_stronger_of_raw_hybrid_and_bpr",
      "minimum_ndcg_at_10_point_delta": -0.0002,
      "minimum_ndcg_at_10_lower_bound_strict": -0.001,
      "minimum_recall_at_10_lower_bound_strict": -0.002,
      "intrusion_comparator": "raw_hybrid",
      "maximum_low_rating_intrusion_at_10_increase_upper_bound": 0.002
    },
    "G5": {
      "name": "matched_mechanism_controls",
      "require_strictly_greater_point_conditional_admission_than": [
        "order_only",
        "uib_boundary",
        "wrong_boundary",
        "shuffled_direction"
      ],
      "require_strictly_greater_point_spce_at_10_than": [
        "admission_only",
        "order_only",
        "uib_boundary",
        "wrong_boundary",
        "shuffled_direction"
      ]
    },
    "G6": {
      "name": "nondegenerate_support_and_power",
      "minimum_R_fixed_pairs": 20000,
      "minimum_R_pair_bearing_users": 1000,
      "minimum_T_fixed_natural_pairs": 5000,
      "minimum_T_pair_bearing_users": 1000,
      "minimum_T_unique_BPR_missed_preferred_endpoints": 5000,
      "minimum_T_missed_endpoint_users": 1000,
      "minimum_admission_membership_changed_vs_raw_fraction": 0.05,
      "minimum_spce_pair_outcome_changed_vs_raw_fraction": 0.02,
      "change_fraction_aggregation": "micro_over_fixed_user_endpoint_or_pair_seed_rows",
      "require_all_fixed_V_power_comparisons": true,
      "minimum_power_detection_fraction_each": 0.8,
      "power_bootstrap_experiments": 1000,
      "failure_policy": "kill_before_T"
    },
    "G7": {
      "name": "seed_stability",
      "require_all_registered_seeds_complete_and_aggregated": true,
      "minimum_independently_stable_seeds": 2,
      "stable_seed_requires_positive_admission_gain_over": ["raw_hybrid", "order_only"],
      "stable_seed_requires_positive_spce_gain_over": ["raw_hybrid"],
      "stable_seed_ndcg_comparator": "raw_hybrid",
      "stable_seed_minimum_ndcg_delta": -0.0002,
      "minimum_any_seed_ndcg_delta": -0.001
    },
    "G8": {
      "name": "serving_latency",
      "measured_requests_exact": 512,
      "cpu_threads": 1,
      "warmups": 32,
      "repetitions": 7,
      "maximum_worst_seed_p95_ms": 10.0,
      "maximum_worst_seed_p95_ratio": 1.25,
      "comparator": "raw_hybrid"
    },
    "G9": {
      "name": "provenance_and_external_replay",
      "require_archive_and_extraction_verification": true,
      "require_cohort_and_temporal_order_verification": true,
      "require_target_blind_candidate_manifest_order": true,
      "require_source_protocol_config_environment_interpreter_hashes": true,
      "require_model_matrix_index_manifest_raw_array_hashes": true,
      "require_bootstrap_replay": true,
      "require_process_exit_and_lock_release": true,
      "require_empty_stderr_and_error_ledgers": true,
      "require_recursive_artifact_hashes": true,
      "require_separately_source_bound_post_exit_verifier": true,
      "external_verifier_recomputes_G1_through_G9": true,
      "sole_authoritative_marker": true
    },
    "combination": "G1_and_G2_and_G3_and_G4_and_G5_and_G6_and_G7_and_G8_and_G9",
    "any_false_or_incomplete_gate": "kill_CABLE_return_to_Phase_1",
    "phase_5_requires_external_PROMISING_true": true,
    "forbid_weighted_rescue_manual_override_threshold_change_cohort_substitution_partial_seed_rescue": true
  },
  "execution": {
    "python_flags": ["-B", "-u"],
    "cpu_only": true,
    "thread_count": 1,
    "numerical_thread_environment_variables": [
      "OMP_NUM_THREADS",
      "MKL_NUM_THREADS",
      "OPENBLAS_NUM_THREADS",
      "NUMEXPR_NUM_THREADS",
      "VECLIB_MAXIMUM_THREADS",
      "BLIS_NUM_THREADS"
    ],
    "cuda_visible_devices": "-1",
    "offline_huggingface_and_transformers": true,
    "hf_hub_disable_progress_bars": true,
    "tqdm_disable": true,
    "pytorch_intraop_threads": 1,
    "pytorch_interop_threads": 1,
    "dataloader_num_workers": 0,
    "unique_append_only_run_directory": true,
    "persistent_stdout_stderr": true,
    "hidden_child_process": true,
    "outer_launcher_lock": true,
    "runner_owner_pid_lock": true,
    "verifier_lock": true,
    "async_exception_hooks": ["threading.excepthook", "sys.unraisablehook"],
    "empty_async_error_ledger_required": true,
    "empty_stderr_required": true,
    "resume_enabled": false,
    "automatic_outcome_retry": false,
    "post_outcome_source_repair": false,
    "completion_candidate_is_authoritative": false,
    "external_verifier_recomputes_raw_metrics_and_gates": true,
    "sole_authoritative_marker_prefix": "CABLE_EXTERNAL_COMPLETE_",
    "sole_authoritative_marker_schema": "cable-pref-external-complete-v1",
    "sole_authoritative_marker_location": "run_directory",
    "sole_authoritative_marker_name": "CABLE_EXTERNAL_COMPLETE_<execution_fingerprint_first_16>.json",
    "exactly_one_external_marker": true,
    "marker_publisher": "launcher_only_after_verifier_exit_and_lock_release",
    "runner_top_level_PROMISING": false,
    "bound_research_sources": ["research_question", "cycle5_survey", "architecture", "protocol", "config", "runner", "launcher"],
    "runner_recursive_closure_excludes": ["runner_completion_candidate", "launcher_and_verifier_owned_logs_reports_locks", "later_external_marker"],
    "phase5_requires_external_promising_true": true
  }
}
