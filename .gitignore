# deposit build artifacts (released as GitHub release assets)
_release/

# render + adjudication scratch (regenerated; never release-swept)
/_paper_render.html
/tmp/
/paper_tex/main.pdf
# raw AR2023 downloads (never redistributed) + runner byproducts (audit 2026-07-19 09:34)
data_raw_proper/
