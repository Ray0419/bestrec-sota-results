#!/usr/bin/env bash
# SEAL pre-push hook (E-G3 custody; audit 2026-07-24). Rejects any push whose
# NEW commits introduce sequestered-endpoint artifacts (defence in depth behind
# pre-commit). Reads the standard pre-push stdin: <local_ref> <local_sha>
# <remote_ref> <remote_sha> per line.
set -u
HERE="$(git rev-parse --show-toplevel)"
. "$HERE/cloud/hooks/seal_patterns.sh"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"                            # new branch: all its commits
  else
    range="$remote_sha..$local_sha"
  fi
  bad="$(git diff --name-only "$range" 2>/dev/null | grep -E "$SEAL_PATTERNS" || true)"
  if [ -n "$bad" ]; then
    echo "SEAL HOOK (pre-push): endpoint artifact(s) in pushed commits ($range):" >&2
    printf '  %s\n' $bad >&2
    echo "Refusing to push sequestered endpoints. Rewrite the offending commit." >&2
    status=1
  fi
done
exit $status
